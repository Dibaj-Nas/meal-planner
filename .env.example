# Planificateur de Repas — variables d'environnement
# Copiez ce fichier : cp .env.example .env

# Application
APP_ENV=development
APP_URL=http://localhost:3000
SESSION_LIFETIME=1800
CSRF_SECRET=changez-cette-cle-secrete-minimum-64-caracteres-xxxx

# Base de données MySQL
DB_HOST=localhost
DB_NAME=meal_planner
DB_USER=root
DB_PASS=

# Compte système (seed data)
SYSTEM_USER_ID=1

# SMTP (optionnel — laisser vide pour désactiver l'envoi d'e-mails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM=
MAIL_FROM_NAME=Planificateur de Repas
